{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },
    "module": "commonjs",
    "target": "es2017",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "@tarojs/plugin-framework-react/types"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
